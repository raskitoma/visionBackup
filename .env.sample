# visionBackup Configuration
# --------------------------
# SOURCE_DBS format: user:pass@host:port/db|description,user:pass@host:port/db|description
# - Comma separates multiple database sources
# - Pipe (|) separates connection string from human-readable description
# - Description is used for folder names and log entries (no spaces, use underscores)
#
# Example:
# SOURCE_DBS="root:secret@localhost:3306/app_prod|production,admin:pw123@10.0.0.5:3306/app_staging|staging"

SOURCE_DBS=""
TARGET_PATH=""
